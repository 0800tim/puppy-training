# /etc/puppy-training.env  (chmod 600)
PUPPY_PIN=482913
PORT=8080
HOST=127.0.0.1
DATA_DIR=/opt/puppy-training/data
# 1 when a proxy you control sits in front (cloudflared, nginx): the visitor address is then read from
# CF-Connecting-IP, or the last X-Forwarded-For hop, never the first entry (the caller can write that one).
TRUST_PROXY=1
SESSION_DAYS=180
# Optional: a second PIN that picking a grown-up profile asks for
# PUPPY_ADULT_PIN=7391
# Host many families on this server (docs/design/HOUSEHOLDS.md). PUPPY_PIN is then read once, to carry an existing store over.
# HOUSEHOLDS=1
# With HOUSEHOLDS=1: how the sign-up and sign-in emails go out. console (default) prints them to the log; sendgrid sends them.
# MAIL=sendgrid
# MAIL_FROM=Puppy School HQ <puppy@example.nz>
# SENDGRID_API_KEY=
# APP_URL=https://puppy.example.nz   # set this on a public server: links in emails must not come from the Host header
# Who may open the owner page (families list, invites, pause, delete). Sign in by email with one of these.
# OWNER_EMAILS=you@example.nz
# Optional: who push services may contact about this sender
# PUSH_SUBJECT=mailto:you@example.com
# Optional: SMS gateway (Aiva-SMS style). Leave out and texts are off.
# AIVA_SMS_API_URL=http://localhost:9252
# AIVA_SMS_API_KEY=
# AIVA_SMS_DEVICE_ID=
# AIVA_SMS_SIM_SUBSCRIPTION_ID=1
