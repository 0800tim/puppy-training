# /etc/puppy-training.env  (chmod 600)
PUPPY_PIN=482913
PORT=8080
HOST=127.0.0.1
DATA_DIR=/opt/puppy-training/data
TRUST_PROXY=1
SESSION_DAYS=180
# Optional: a second PIN that picking a grown-up profile asks for
# PUPPY_ADULT_PIN=7391
# Optional: who push services may contact about this sender
# PUSH_SUBJECT=mailto:you@example.com
# Optional: SMS gateway (Aiva-SMS style). Leave out and texts are off.
# AIVA_SMS_API_URL=http://localhost:9252
# AIVA_SMS_API_KEY=
# AIVA_SMS_DEVICE_ID=
# AIVA_SMS_SIM_SUBSCRIPTION_ID=1
